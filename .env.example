# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "Coloring Pages"
NEXT_PUBLIC_SITE_URL = "http://localhost:3000"

# ============================================
# Theme & Appearance
# ============================================
NEXT_PUBLIC_THEME = "default"
NEXT_PUBLIC_APPEARANCE = "system"

# ============================================
# Database (Supabase PostgreSQL)
# ============================================
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""  # Format: postgresql://user:pass@host:port/db
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"
DB_SCHEMA = "public"
DB_MIGRATIONS_TABLE = "__drizzle_migrations"
DB_MIGRATIONS_SCHEMA = "drizzle"

# ============================================
# Authentication
# ============================================
AUTH_URL = "http://localhost:3000"
AUTH_SECRET = ""  # Generate: openssl rand -base64 32

# ============================================
# AI Services
# ============================================
# Replicate API for AI image generation
REPLICATE_API_TOKEN = ""

# Hugging Face API
HF_TOKEN = ""

# DeepSeek API
DEEPSEEK_API = ""

# ============================================
# Cloudflare R2 Storage
# ============================================
CF_R2_ACCOUNT_ID = ""
CF_R2_TOKEN = ""
R2_ACCESS_KEY_ID = ""
R2_SECRET_ACCESS_KEY = ""
R2_PUBLIC_DOMAIN = "https://images.yourdomain.com"
R2_DOMAIN = "https://images.yourdomain.com"
R2_BUCKET_NAME = "your-bucket-name"

# ============================================
# Cloudflare API
# ============================================
CLOUDFLARE_API_TOKEN = ""

# ============================================
# Pinterest Configuration
# ============================================
# Get your credentials at: https://developers.pinterest.com/apps/
# Add this callback URL in your Pinterest app: https://yourdomain.com/api/pinterest/callback
PINTEREST_APP_ID = ""
PINTEREST_APP_SECRET = ""
PINTEREST_REFRESH_TOKEN = ""
PINTEREST_BOARD_ID = ""

# Use API Sandbox for testing (Trial accounts only)
# Set to 'true' if your app is in trial mode
# Trial apps must use sandbox: https://api-sandbox.pinterest.com
# Production apps use: https://api.pinterest.com
PINTEREST_USE_SANDBOX = ""

# Sandbox access token for testing (optional)
# Only needed if using sandbox mode without OAuth
PINTEREST_SANDBOX_TOKEN = ""

# ============================================
# RSS to Pinterest Sync
# ============================================
# Cron secret for protecting RSS to Pinterest sync endpoint
# Generate: openssl rand -base64 32
CRON_SECRET = ""

# ============================================
# Kaggle Configuration
# ============================================
KAGGLE_USERNAME = ""
KAGGLE_KEY = ""
KAGGLE_NOTEBOOK_SLUG = ""
KAGGLE_NOTEBOOK_VERSION = ""

# ============================================
# Gist Keywords Configuration
# ============================================
# GitHub personal access token for accessing Gist keywords
# Create at: https://github.com/settings/tokens
# Required scopes: gist (read and write)
GIST_COLORING_TOKEN = ""

# ============================================
# Coloring Workflow Configuration
# ============================================
COLORING_WORKFLOW_ENABLED = true
COLORING_WORKFLOW_SCHEDULE_TIME = 02:00
COLORING_WORKFLOW_MAX_DAILY = 100
COLORING_MDX_PATH = content/coloring-pages
COLORING_R2_PATH = coloring-pages

# ============================================
# Image Quality Settings
# ============================================
COLORING_MIN_IMAGE_WIDTH = 512
COLORING_MAX_IMAGE_WIDTH = 4096
COLORING_MIN_IMAGE_SIZE = 10240
COLORING_MAX_IMAGE_SIZE = 5242880
COLORING_MIN_QUALITY_SCORE = 70
COLORING_USE_AI_VALIDATION = true
COLORING_AI_VALIDATION_MODEL = openai
